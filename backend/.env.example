# STEMLearn Backend Environment Variables Example
FLASK_ENV=development
SECRET_KEY=generate_a_secure_random_secret_key_here
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_here
FERNET_KEY=generate_a_32_byte_base64_fernet_key_here

# MongoDB Atlas / Local Connection URI
MONGO_URI=mongodb://localhost:27017/stem_learning

# AI Provider Keys & Models (Never hardcode in codebase)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Uploads Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Rate Limiting
RATELIMIT_DEFAULT=100/hour
LOGIN_RATELIMIT=5/minute

# SMTP Configuration (Optional env fallbacks; configurable via Admin Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="STEMLearn Academy"
